    "demo": "node scripts/demo.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ioredis": "^5.4.2"
  },
