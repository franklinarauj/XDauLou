{
  "name": "xdaulou",
  "version": "1.0.0",
  "description": "Baixe vídeos e GIFs de posts do X (Twitter) com fricção zero.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franklinarauj/XDauLou.git"
  },
  "homepage": "https://github.com/franklinarauj/XDauLou#readme",
  "keywords": [
    "twitter",
    "x",
    "video-downloader",
    "gif",
    "ffmpeg",
    "express"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
