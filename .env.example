# Copie para .env e ajuste. Todas as variáveis são opcionais.

PORT=3000
HOST=0.0.0.0

# Número de proxies reversos na frente (nginx, Cloudflare): use 1 para o rate limit
# enxergar o IP real. "true" também vale 1 (confiar em todos permitiria forjar o IP).
TRUST_PROXY=false

# Redis para cache e rate limit compartilhados. Vazio = memória do processo.
REDIS_URL=

CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=1000
UPSTREAM_TIMEOUT_MS=10000

# Segredo dos links de download assinados. Vazio = aleatório a cada início.
# Defina um valor fixo e longo se rodar mais de uma instância.
URL_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=7200

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXTRACT=30
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_GIF=6

RATE_LIMIT_STICKER=10

# Conversões simultâneas (GIF e figurinha somados).
MAX_CONCURRENT_JOBS=2

STICKER_MAX_UPLOAD_MB=15
STICKER_TARGET_KB=480
STICKER_GIF_MAX_MB=4
STICKER_TIMEOUT_MS=60000

GIF_MAX_DURATION_SECONDS=60
GIF_MAX_INPUT_MB=80
GIF_MAX_OUTPUT_MB=40
GIF_TIMEOUT_MS=120000

# Caminhos dos binários, se não estiverem no PATH.
FFMPEG_PATH=
YTDLP_PATH=
